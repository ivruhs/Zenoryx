# =============================================================================
# ZENORYX API — environment template
#   cp env.example .env   — then fill in. Every service has a free tier; no card.
# =============================================================================

# Postgres with pgvector (Neon free tier). Run once in its SQL editor:
#   CREATE EXTENSION IF NOT EXISTS vector;
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# 32+ random bytes used to HMAC-sign session cookies:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COOKIE_SECRET="replace-me"

# Google AI Studio — embeddings (required) + primary chat pool
GEMINI_API_KEY=""
# Groq — chat pool for ingestion summaries and failover (recommended)
GROQ_API_KEY=""

# Optional: raises GitHub's limit from 60 to 5,000 req/h (no scopes needed).
# If missing or expired the app falls back to anonymous access.
GITHUB_TOKEN=""

PORT=8000
NODE_ENV="development"
# Only needed when a browser calls the API from another origin (the Next.js
# /api proxy makes requests same-origin). Comma-separated.
FRONTEND_URL="http://localhost:3000"

# ---- Optional tuning --------------------------------------------------------
# GEMINI_CHAT_MODELS="gemini-3.1-flash-lite,gemini-flash-lite-latest,gemini-3.5-flash-lite,gemini-2.5-flash-lite"
# GROQ_CHAT_MODELS="openai/gpt-oss-120b,openai/gpt-oss-20b,qwen/qwen3.8-27b"
# MAX_FILES=36
# MAX_CHUNKS=180
# QA_PER_HOUR=40
# COOKIE_CROSS_SITE=false
