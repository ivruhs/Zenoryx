{
  "name": "zenoryx-backend",
  "version": "1.0.0",
  "description": "Zenoryx API — semantic code search & RAG over GitHub repositories",
  "main": "src/server.js",
  "prisma": {
    "schema": "src/prisma/schema.prisma"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "start": "node src/server.js",
    "dev": "nodemon --watch src src/server.js",
    "migrate": "prisma migrate deploy",
    "build": "prisma generate && prisma migrate deploy",
    "doctor": "node scripts/doctor.js",
    "test": "NODE_ENV=test node --test --test-concurrency=1 test/*.test.js",
    "test:e2e": "NODE_ENV=test E2E=1 node --test --test-concurrency=1 test/*.test.js",
    "test:unit": "NODE_ENV=test node --test test/unit.test.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@octokit/rest": "^22.0.1",
    "@prisma/adapter-pg": "^6.19.3",
    "@prisma/client": "^6.19.3",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "pg": "^8.23.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "prisma": "^6.19.3",
    "tree-sitter": "^0.21.1",
    "tree-sitter-cpp": "^0.23.4",
    "tree-sitter-java": "^0.23.5",
    "tree-sitter-javascript": "^0.21.3",
    "tree-sitter-python": "^0.21.0",
    "tree-sitter-typescript": "^0.21.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  },
  "engines": {
    "node": ">=20.10"
  }
}
