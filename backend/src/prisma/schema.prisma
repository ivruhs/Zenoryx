// =============================================================================
// ZENORYX — PRISMA SCHEMA
// PostgreSQL + pgvector (NeonDB free tier)
//
// One-time setup in the Neon SQL editor:
//   CREATE EXTENSION IF NOT EXISTS vector;
//
// Apply migrations:   npx prisma migrate deploy
// Regenerate client:  npx prisma generate
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Ingestion lifecycle. Postgres is the source of truth for the job queue:
// PENDING rows are picked up by the in-process runner (and recovered on boot).
enum ProjectStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String // bcrypt hash (cost 12)
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions Session[]
  projects Project[]
  messages ChatMessage[]

  @@map("users")
}

// Server-side sessions: instant revocation, HMAC-signed token in an HttpOnly cookie.
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  expiresAt    DateTime
  userAgent    String
  createdAt    DateTime @default(now())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Project {
  id        String @id @default(cuid())
  name      String // "owner/repo"
  repoUrl   String
  repoOwner String
  repoName  String

  status       ProjectStatus @default(PENDING)
  stage        String? // fine-grained pipeline stage: queued | fetching | parsing | summarizing | embedding | commits | done
  errorMessage String?
  attempts     Int           @default(0)

  // Repository metadata captured at ingestion time
  description     String?
  stars           Int?
  primaryLanguage String?
  defaultBranch   String?
  commitSha       String? // exact snapshot that was indexed (used for stable GitHub links)

  totalFiles     Int    @default(0) // supported code files found in the repo
  fileCount      Int    @default(0) // files selected for indexing
  processedCount Int    @default(0) // files processed so far (progress bar)
  chunkCount     Int    @default(0) // semantic chunks stored
  totalSize      BigInt @default(0)
  fileIndex      Json? // [{ path, language, size, summary, chunks }] for the file explorer
  languages      Json? // [{ language, bytes, share }]

  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  userId   String
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  chunks   CodeChunk[]
  commits  Commit[]
  messages ChatMessage[]

  @@index([userId])
  @@index([status])
  @@map("projects")
}

// One semantically coherent unit of code (function / class / method / fallback window).
model CodeChunk {
  id         String  @id @default(cuid())
  filePath   String
  chunkIndex Int
  summary    String
  content    String
  language   String?
  symbol     String? // e.g. "AuthService.login"
  nodeType   String? // tree-sitter node type, or "window" for fallback chunks
  startLine  Int?
  endLine    Int?

  // 3072-d Gemini embedding. Written/read via raw SQL only.
  embedding Unsupported("vector(3072)")

  createdAt DateTime @default(now())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, filePath, chunkIndex])
  @@index([projectId])
  @@map("code_chunks")
}

model Commit {
  id          String   @id @default(cuid())
  sha         String
  message     String
  authorName  String
  authorEmail String
  date        DateTime
  aiSummary   String
  additions   Int?
  deletions   Int?
  createdAt   DateTime @default(now())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, sha])
  @@index([projectId])
  @@map("commits")
}

// Persisted conversation history (enables follow-up questions + cross-device sync).
model ChatMessage {
  id        String   @id @default(cuid())
  role      String // "user" | "assistant"
  content   String
  sources   Json?
  latencyMs Int?
  createdAt DateTime @default(now())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@map("chat_messages")
}
