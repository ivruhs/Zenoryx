# Where the Zenoryx API runs. The browser never calls it directly: Next.js
# proxies /api/* to this URL so session cookies stay first-party.
# (NEXT_PUBLIC_API_URL is still accepted for backwards compatibility.)
BACKEND_URL="http://localhost:8000"

# Public URL of this site (used for absolute Open Graph URLs).
# NEXT_PUBLIC_SITE_URL="https://zenoryx.vercel.app"
